# =============================================================================
# SITHUMINI CINNAMON HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local (for local development) or configure in Vercel.
# NEVER commit .env.local or real secrets to Git.
# =============================================================================

# Node Environment
NODE_ENV=development
SERVER_PORT=4000

# -----------------------------------------------------------------------------
# BACKEND & ADMIN AUTHENTICATION (SERVER-SIDE ONLY)
# Note: Never use VITE_ prefixes for credentials or server secrets.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_strong_admin_password_here
SESSION_SECRET=generate_a_random_32_character_string_here

# -----------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE (Free Tier: 500 MB DB)
# Obtain from https://app.supabase.com -> Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Used only by public client if needed (read active products & approved reviews)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# SERVER-SIDE ONLY: Never expose to browser. Used by server to update catalog & moderate reviews
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# -----------------------------------------------------------------------------
# META WHATSAPP CLOUD API (Free Tier: 1,000 service conversations/month free)
# Obtain from https://developers.facebook.com -> App -> WhatsApp -> API Setup
# Use the Meta Test Number during development. NEVER touch the live business number.
# -----------------------------------------------------------------------------
# System User Access Token (from Meta Business Manager)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
# Secret for triggering durable inbox retry worker
CRON_SECRET=generate_a_random_32_character_string_here
# Meta Test Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
# Random secret string you configure in Meta Webhook Configuration for challenge handshake
WHATSAPP_VERIFY_TOKEN=create_a_secure_random_verify_token_here
# Meta App Secret (App Settings -> Basic -> App Secret) for X-Hub-Signature-256 validation
WHATSAPP_APP_SECRET=your_meta_app_secret_here
# Store owner/manager phone number for escalation alerts (with country code, no + or spaces)
OWNER_PHONE_NUMBER=94771234567
